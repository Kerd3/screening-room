{
  "name": "entertainment-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "recs:rebuild": "tsx --conditions=react-server scripts/rebuild-recs.ts",
    "alerts:check": "tsx --conditions=react-server scripts/check-seasons.ts",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "db:migrate:dev": "prisma migrate dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "next typegen && tsc --noEmit",
    "recs:eval": "tsx --conditions=react-server scripts/evaluate-recs.ts",
    "recs:tune": "tsx --conditions=react-server scripts/tune-recs.ts",
    "recs:tune-cf": "tsx --conditions=react-server scripts/tune-cf.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.108.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "iron-session": "^9.1.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
