# Neon Postgres (Vercel > Storage > Neon fills these in; then run: npx vercel env pull .env)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# TMDB v4 API Read Access Token: https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=""

# Encrypts the session cookie (32+ characters)
SESSION_PASSWORD="generate-a-random-32+-char-string"

# Protects POST /api/cron/check-seasons
CRON_SECRET="generate-a-random-string"

# Outbound TMDB requests per second (TMDB allows roughly 40-50)
TMDB_MAX_RPS=35

# Optional: Upstash Redis shares rate limits across servers (Vercel > Storage > Upstash)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
